# ========================================================
# Research Analyst Multi-Agent Assistant Environment Configuration
# ========================================================

# Groq API Key (Get a free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Groq Model Identifier (e.g. qwen/qwen3.8-27b or llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# Server Networking
HOST=127.0.0.1
PORT=8000

# Request Timeout (seconds)
REQUEST_TIMEOUT=60
